# SMTP credentials used by Nodemailer (lib/email.ts) to send form-submission
# emails. Any SMTP provider works (Gmail app password, SendGrid, Mailgun,
# Amazon SES, your own mail server, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sending address shown in the "From" header. Falls back to SMTP_USER if
# unset — most providers require the From address to match (or be verified
# against) the authenticated SMTP account anyway.
CONTACT_FROM_EMAIL=

# Inbox that receives every form submission (contact, hero quick-enquiry,
# web brief, logo brief).
CONTACT_TO_EMAIL=connect@thesocialnexus.co.uk

# Supabase project backing the /admin dashboard (portfolio/services/FAQs +
# image uploads) AND the public site's data (Portfolio, Services, FAQs
# sections all read from these tables). Project Settings -> API in the
# Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — server-only,
# used only by the admin dashboard, never expose it to the client.
# SUPABASE_ANON_KEY is used by the public pages, which read through Row
# Level Security (published rows only) instead of bypassing it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# The /admin login credentials are hardcoded in lib/auth/credentials.ts
# (no env setup needed) — see that file to change the email/password.
